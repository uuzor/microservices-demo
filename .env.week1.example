# Vibe Markets - Week 1 Environment Configuration

# Kafka / Confluent Cloud Configuration
ENABLE_KAFKA=1
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=your_confluent_api_key_here
KAFKA_API_SECRET=your_confluent_api_secret_here

# Google Cloud Configuration (for Week 2+)
GOOGLE_CLOUD_PROJECT=vibe-markets
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GEMINI_API_KEY=your_gemini_api_key_here

# Service Ports
MARKET_SERVICE_PORT=3550
BETTING_SERVICE_PORT=3551

# Development Settings
ENV=development
LOG_LEVEL=debug
